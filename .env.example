# EmailJS — sign up free at https://emailjs.com
# Dashboard → Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=

# Dashboard → Email Services → your service ID
VITE_EMAILJS_SERVICE_ID=

# Dashboard → Email Templates → contact template ID
VITE_EMAILJS_CONTACT_TEMPLATE=

# Dashboard → Email Templates → admissions template ID
VITE_EMAILJS_ADMISSION_TEMPLATE=

# Google Analytics 4 — free at https://analytics.google.com
# Admin → Data Streams → your web stream → copy the Measurement ID (G-XXXXXXXXXX).
# Leave BLANK to disable analytics entirely: no script is loaded and no data is sent.
VITE_GA_MEASUREMENT_ID=

# ── School-editable content (Google Sheets read as CSV) ────────────────────
# For each sheet: Share > General access > Anyone with the link > Viewer.
# Then take the sheet id out of its address and use the export link below.
# Publishing to the web is NOT needed; the export endpoint already allows the
# site to read it. Leave any of these blank and that section falls back to the
# bundled defaults, so the site always works.
#
#   https://docs.google.com/spreadsheets/d/PUT_THE_SHEET_ID_HERE/export?format=csv
#
# Column templates with examples: docs/sheet-templates/, or the /admin page.
VITE_SHEET_ANNOUNCEMENTS=
VITE_SHEET_EVENTS=
VITE_SHEET_DOCUMENTS=

# Optional. The normal editing address of each sheet, which turns the save step
# on /admin into a single button for the office.
VITE_SHEET_ANNOUNCEMENTS_EDIT=
VITE_SHEET_EVENTS_EDIT=
VITE_SHEET_DOCUMENTS_EDIT=

# hCaptcha — sign up free at https://dashboard.hcaptcha.com
# Add a new site → copy the Site Key
# During development the test key below always passes:
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
