# EmailJS — sign up free at https://emailjs.com
# Dashboard → Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=

# Dashboard → Email Services → your service ID
VITE_EMAILJS_SERVICE_ID=

# Dashboard → Email Templates → contact template ID
VITE_EMAILJS_CONTACT_TEMPLATE=

# Dashboard → Email Templates → admissions template ID
VITE_EMAILJS_ADMISSION_TEMPLATE=

# hCaptcha — sign up free at https://dashboard.hcaptcha.com
# Add a new site → copy the Site Key
# During development the test key below always passes:
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
