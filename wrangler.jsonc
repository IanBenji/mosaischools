{
  // Cloudflare Worker that serves the MOSAI Schools site (www.mosaischools.com).
  // Workers Builds runs `npm run build`, then `npx wrangler deploy` with this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosaischools",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker code; every other request is served
    // straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  // Contact and Donate form emails. Requires Email Routing on mosaischools.com.
  // The inbox is the MAIL_TO secret (set in the Cloudflare dashboard, Worker >
  // Settings > Variables and Secrets); it must be a verified Email Routing
  // destination address. Change it there, no code change needed.
  "send_email": [
    { "name": "MAIL" }
  ],
  "keep_vars": true,
  "observability": { "enabled": true }
}
